ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
GHL_API_TOKEN=
# The one GoHighLevel pipeline OrderBridge may act on (needed by `serve` and `availability`):
# GHL_PIPELINE_ID=
# Optional: PostgreSQL for idempotency keys, object links and the audit log.
# Local development database from docker-compose.yml (development-only credentials):
# DATABASE_URL=postgresql+psycopg://orderbridge:orderbridge@localhost:5436/orderbridge
# Optional: shared secret for the webhook server (python -m app serve). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=
# Optional: group and territory given to customers OrderBridge creates in ERPNext
# ERPNEXT_DEFAULT_CUSTOMER_GROUP=Commercial
# ERPNEXT_DEFAULT_TERRITORY=Rest Of The World
# Optional overrides:
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
